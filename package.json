{
  "name": "agent-relay",
  "version": "0.3.0",
  "private": false,
  "license": "MIT",
  "description": "Dev Boards + BeeZilla \u2014 mission boards for AI agents, and a consumer orchestrator for people",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GumbyEnder/agent-relay.git"
  },
  "bugs": {
    "url": "https://github.com/GumbyEnder/agent-relay/issues"
  },
  "homepage": "https://github.com/GumbyEnder/agent-relay#readme",
  "sideEffects": false,
  "type": "module",
  "overrides": {
    "pptxgenjs": {
      "image-size": "^2.0.3"
    },
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "bin": {
    "beezilla": "bin/beezilla.mjs"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 8080",
    "build": "vite build",
    "prebuild": "node scripts/sync-private.mjs && node scripts/assert-no-private-modules.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "build:dev": "vite build --mode development",
    "preview": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "parity": "node scripts/parity-check.mjs",
    "gate:hard-nav": "node scripts/gate-hard-nav.mjs",
    "test:shell-history": "node --test scripts/test-shell-history.mjs",
    "test:page-aliases": "node --test scripts/test-page-aliases.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "verify": "npm run typecheck && npm run build && npm run test:ci",
    "test:ci": "npm run test:page-aliases && npm run test:shell-history && npm run test:honcho-privacy && npm run test:engine && npm run test:openapi-sync && npm run test:bz-f001-profile && npx tsx scripts/test-tool-registry.ts && npx tsx scripts/test-voice-tools.ts && npx tsx scripts/test-file-intent.ts && node scripts/test-0055-replay.mjs && npm run test:desktop-boundaries",
    "test:engine": "npx tsx scripts/test-board-engine.ts && npx tsx scripts/test-stale-sweep.ts && npm run test:history && npm run test:build-order && npm run test:refresh-scope && npm run test:p0p2 && npm run test:prod && npm run test:auth-email && npm run test:tenancy && npm run test:tenancy-endpoints && npm run test:skill-routing && npm run test:project-ref && npm run test:docs-html && npm run test:github-ingest",
    "test:tenancy": "npx tsx scripts/test-board-tenancy.ts",
    "test:skill-routing": "npx tsx scripts/test-skill-routing.ts",
    "test:project-ref": "npx tsx scripts/test-project-ref.ts",
    "test:docs-html": "npx tsx scripts/test-docs-html.ts",
    "test:tenancy-endpoints": "npx tsx scripts/test-tenancy-endpoints.ts",
    "test:github-ingest": "npx tsx scripts/test-github-ingest-extras.ts && npx tsx scripts/test-ingest-authz.ts",
    "test:api": "node scripts/agent-api-smoke.mjs",
    "test:buzzy-jobs": "node scripts/test-buzzy-jobs-ownership.mjs",
    "test:buzzy-resume": "node scripts/test-buzzy-resume.mjs",
    "smoke": "npm run test:engine && npm run test:api",
    "start": "node scripts/migrate.mjs && node scripts/start-server.mjs",
    "local": "node scripts/beezilla-local.mjs",
    "test:local": "node scripts/test-local-e2e.mjs",
    "postbuild": "node scripts/build-desktop-csp.mjs && echo build complete",
    "test:history": "npx tsx scripts/test-history.ts",
    "test:build-order": "npx tsx scripts/test-build-order.ts",
    "test:refresh-scope": "npx tsx scripts/test-refresh-scope.ts",
    "test:p0p2": "npx tsx scripts/test-p0-p2.ts",
    "mcp": "node scripts/mcp-server.mjs",
    "test:prod": "npx tsx scripts/test-prod-ready.ts",
    "test:auth-email": "npx tsx scripts/test-auth-email.ts",
    "test:bz-f001-profile": "npx tsx scripts/test-bz-f001-profile.ts",
    "tui": "npm --prefix apps/tui run dev",
    "tui:status": "npm --prefix apps/tui run status",
    "tui:build": "npm --prefix apps/tui run build",
    "test:openapi-sync": "node scripts/test-openapi-sync.mjs",
    "test:tools": "npx tsx scripts/test-tool-registry.ts && npx tsx scripts/test-webpage-routing.ts && npx tsx scripts/test-voice-tools.ts && npx tsx scripts/test-file-intent.ts",
    "pretypecheck": "node scripts/sync-private.mjs",
    "private:sync": "node scripts/sync-private.mjs",
    "private:check": "node scripts/sync-private.mjs --check",
    "private:verify": "node scripts/sync-private.mjs --check --require-private",
    "test:desktop-boundaries": "npm run test:library-vault && npm run test:talk-sessions && npm run test:memory-scope && npm run test:desktop-settings-provenance && node scripts/test-electron-ui-parity.mjs && node --experimental-vm-modules --test scripts/test-desktop-connect-guard.mjs scripts/test-local-db-boundary.mjs scripts/test-local-runtime-inference-boundary.mjs scripts/test-local-asset-boundary.mjs scripts/test-local-start-boundary.mjs && node scripts/test-llm-boundary.mjs && node scripts/test-private-boundary.mjs && npx tsx scripts/test-recipe-local-boundary.ts && node --test --test-concurrency=1 scripts/test-desktop-hardening.mjs scripts/test-desktop-csp.mjs scripts/test-desktop-lifecycle.mjs scripts/test-desktop-credential-env.mjs scripts/test-desktop-after-pack.mjs scripts/test-desktop-harness.mjs scripts/test-honcho-privacy.mjs",
    "test:honcho-privacy": "node --test scripts/test-honcho-privacy.mjs",
    "test:desktop-connect-guard": "node --experimental-vm-modules --test scripts/test-desktop-connect-guard.mjs",
    "test:desktop-settings-provenance": "node --experimental-vm-modules --test scripts/test-desktop-settings-provenance.mjs",
    "test:library-vault": "node --experimental-vm-modules --test scripts/test-library-vault-backend.mjs scripts/test-library-vault-client.mjs scripts/test-desktop-library-transition.mjs scripts/test-library-port-regression.mjs",
    "test:talk-sessions": "node --experimental-vm-modules --test scripts/test-talk-session-lifecycle.mjs scripts/test-talk-voice-lifecycle.mjs",
    "test:memory-scope": "node --experimental-vm-modules --test scripts/test-memory-scope-backend.mjs scripts/test-memory-scope-ui.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.3",
    "@hookform/resolvers": "^5.0.0",
    "@openpanel/web": "^1.4.1",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.1.0",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-start": "^1.169.3",
    "@tanstack/react-table": "^8.21.0",
    "@tanstack/router-plugin": "^1.168.47",
    "better-auth": "^1.7.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.0.0",
    "docx": "+9.12.0",
    "exceljs": "+4.4.0",
    "kysely": "^0.28.5",
    "lucide-react": "^0.510.0",
    "nodemailer": "^10.1.4",
    "pg": "^8.16.3",
    "pptxgenjs": "+4.0.1",
    "react": "^19.1.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.54.0",
    "react-resizable-panels": "^4.6.5",
    "recharts": "^2.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.3.4",
    "vaul": "^1.1.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.16.5",
    "@types/nodemailer": "^6.4.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "lightningcss": "^1.28.0",
    "nitro": "3.0.260603-beta",
    "playwright": "^1.52.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=22"
  },
  "optionalDependencies": {
    "lru-cache": "+11.5.2"
  }
}
